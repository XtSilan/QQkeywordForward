APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_PATH=/app/data/nonebot/bot.sqlite3
LOG_DIR=/app/data/logs/nonebot
NAPCAT_WEBUI_URL=http://napcat:6099
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_CREDENTIAL=
NAPCAT_PASSWORD_LOGIN_ENABLED=false
NAPCAT_CONTAINER_NAME=qq-bot-napcat
NONEBOT_CONTAINER_NAME=qq-bot-nonebot
WEBUI_CONTAINER_NAME=qq-bot-webui
DOCKER_SOCKET=/var/run/docker.sock
CONTROL_ENABLED=false
ADMIN_TOKEN=change-me
ENVIRONMENT=prod
DRIVER=~fastapi
# OneBot V11 鉴权 token：两个变量必须填相同值，都留空则不做鉴权。
# ONEBOT_ACCESS_TOKEN 由 WebUI 下发给 NapCat；ONEBOT_V11_ACCESS_TOKEN 由
# NoneBot 的 OneBot V11 适配器用来校验入站连接。
ONEBOT_ACCESS_TOKEN=
ONEBOT_V11_ACCESS_TOKEN=
# 反向 WS 目标地址（NapCat 作为 client 连到 NoneBot）
ONEBOT_WS_URL=ws://nonebot:8081/onebot/v11/ws
ONEBOT_V11_SECRET=

# --- CI/CD 自动更新（deploy/updater 容器） ---
# 触发链：git push -> GitHub Actions 测试 -> POST :18081/api/webhook -> 容器内
# git pull + docker compose build/up；UPDATER_POLL_INTERVAL 秒轮询 origin 兜底。
UPDATER_ENABLED=true
# 手动触发 /api/update、/api/check 的 Bearer token（留空则禁用这两个接口）
UPDATER_TOKEN=
# webhook 验签密钥，与 GitHub Secrets.DEPLOY_WEBHOOK_SECRET 保持一致
# （留空且 UPDATER_TOKEN 有值时退回 X-Updater-Token 头校验；两者都留空则 webhook 拒绝服务）
UPDATER_WEBHOOK_SECRET=
UPDATER_BRANCH=master
# 轮询间隔（秒，最小15）：没有公网 IP 时这是唯一触发源（默认5分钟，可改60）；
# 有公网 webhook 时仅作兜底。GitHub Secrets 不配 DEPLOY_WEBHOOK_URL 即纯轮询模式。
UPDATER_POLL_INTERVAL=300
UPDATER_AUTO_UPDATE=true

# 构建版本号：updater 每次重建时自动写入（git short SHA），WebUI 侧边栏显示。
# 手动构建想显示版本可自行填 APP_VERSION=$(git rev-parse --short HEAD)。
APP_VERSION=dev
APP_BUILD_TIME=

# 可选：镜像构建时的 pip 源（nonebot / webui / updater 三个 build 共用）。
# 默认清华源；腾讯云内网可改成 http://mirrors.tencentyun.com/pypi/simple/ 。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 宿主机端口映射（compose 插值用） ---
# 只改宿主机侧端口，容器内端口固定（服务间互访靠容器网络，不受影响）。
# 这些变量从 .env 读取；.env 是指向 .env.prod 的软链（compose 固定读 .env 做插值）。
# .env / .env.prod 都被 Git 忽略，改端口不会和自动更新的 git pull 冲突。
# 改完执行 `docker compose up -d` 生效。
WEBUI_HOST_PORT=18080         # WebUI 控制台（改后 PUBLIC_BASE_URL 要跟着改）
NONEBOT_HOST_PORT=8081        # NoneBot OneBot V11 反向 WS 入口
NAPCAT_WEBUI_HOST_PORT=6099   # NapCat WebUI（二维码登录页）
NAPCAT_ONEBOT_HOST_PORT=3001  # NapCat OneBot 网络端口
UPDATER_HOST_PORT=18081       # CI/CD webhook；改后需同步更新 GitHub Secret DEPLOY_WEBHOOK_URL


